{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videopilot.local/schemas/dataset-manifest.schema.json",
  "title": "VideoPilot evaluation dataset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["datasetId", "dataVersion", "schemaVersion", "split", "status", "datasetFingerprint", "videos", "caseCounts"],
  "properties": {
    "datasetId": { "type": "string", "format": "uuid" },
    "dataVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "schemaVersion": { "const": 1 },
    "split": { "enum": ["dev", "test"] },
    "status": { "enum": ["draft", "frozen"] },
    "datasetFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "frozenAt": { "type": ["string", "null"], "format": "date-time" },
    "videos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["videoRef", "topic", "sourceRights", "mediaFingerprint"],
        "properties": {
          "videoRef": { "type": "string", "minLength": 1 },
          "topic": { "type": "string", "minLength": 1 },
          "sourceRights": { "enum": ["owned", "licensed", "public_domain", "synthetic"] },
          "mediaFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "caseCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retrieval", "answer", "reliability", "approved", "total"],
      "properties": {
        "retrieval": { "type": "integer", "minimum": 0 },
        "answer": { "type": "integer", "minimum": 0 },
        "reliability": { "type": "integer", "minimum": 0 },
        "approved": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
