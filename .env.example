# Development-only placeholders used by Docker Compose. Never commit real credentials.
# Maven does not load this file; export overrides into the shell that starts Spring Boot.
MYSQL_DATABASE=videopilot
MYSQL_USER=videopilot
MYSQL_PASSWORD=videopilot_local
MYSQL_ROOT_PASSWORD=videopilot_root_local
MYSQL_PORT=3306
SERVER_PORT=8080
MYSQL_CONNECTION_TIMEOUT=2000
MYSQL_VALIDATION_TIMEOUT=1000
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CONNECT_TIMEOUT=2s
REDIS_COMMAND_TIMEOUT=2s
RABBITMQ_HOST=localhost
RABBITMQ_USER=videopilot
RABBITMQ_PASSWORD=videopilot_local
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_CONNECTION_TIMEOUT=2s
MINIO_ROOT_USER=videopilot
MINIO_ROOT_PASSWORD=videopilot_local
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
DEPENDENCY_HEALTH_TIMEOUT=2s
MINIO_HEALTH_URL=http://localhost:9000/minio/health/ready
QDRANT_HEALTH_URL=http://localhost:6333/healthz
