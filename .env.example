# Development-only placeholders used by Docker Compose. Never commit real credentials.
# Maven does not load this file; export overrides into the shell that starts Spring Boot.
MYSQL_DATABASE=videopilot
MYSQL_USER=videopilot
MYSQL_PASSWORD=videopilot_local
MYSQL_ROOT_PASSWORD=videopilot_root_local
MYSQL_PORT=3306
SERVER_PORT=8080
IDENTITY_BOOTSTRAP_ENABLED=false
IDENTITY_BOOTSTRAP_USERNAME=
IDENTITY_BOOTSTRAP_PASSWORD=
IDENTITY_SECURE_COOKIE=false
MYSQL_CONNECTION_TIMEOUT=2000
MYSQL_VALIDATION_TIMEOUT=1000
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CONNECT_TIMEOUT=2s
REDIS_COMMAND_TIMEOUT=2s
RABBITMQ_HOST=localhost
RABBITMQ_USER=videopilot
RABBITMQ_PASSWORD=videopilot_local
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_CONNECTION_TIMEOUT=2s
ANALYSIS_CONSUMER_ENABLED=true
ANALYSIS_CONSUMER_MAX_RETRIES=3
ANALYSIS_CONSUMER_MAX_PAYLOAD_BYTES=4096
ANALYSIS_CONSUMER_PREFETCH=1
ANALYSIS_CONSUMER_CONCURRENCY=1
ANALYSIS_CONSUMER_LOCK_WAIT=100ms
ANALYSIS_CONSUMER_LOCK_LEASE=30s
ANALYSIS_PIPELINE_VERSION=m2-context-v1
ANALYSIS_ACTIVE_CACHE_TTL=30m
SILICONFLOW_ASR_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=
TELESPEECH_ASR_MODEL_VERSION=TeleAI/TeleSpeechASR
TELESPEECH_ASR_TIMEOUT=120s
ASR_ENABLED=false
ASR_TEMPORARY_DIRECTORY=
ASR_MAX_AUDIO_BYTES=52428800
ASR_MAX_RESPONSE_BYTES=1048576
ASR_MAX_CONCURRENCY=1
ASR_QUEUE_CAPACITY=2
ASR_MAX_ATTEMPTS=3
OCR_ENABLED=false
TESSERACT_EXECUTABLE=tesseract
TESSDATA_DIRECTORY=/usr/share/tesseract-ocr/5/tessdata
TESSERACT_LANGUAGE=eng
TESSERACT_TIMEOUT=30s
OCR_MAX_OUTPUT_BYTES=1048576
OCR_MAX_TEXT_CHARACTERS=100000
OCR_MAX_IMAGE_BYTES=20971520
OCR_MAX_PIXELS=40000000
OCR_MAX_CONCURRENCY=1
OCR_QUEUE_CAPACITY=4
OCR_MAX_ATTEMPTS=2
MINIO_ROOT_USER=videopilot
MINIO_ROOT_PASSWORD=videopilot_local
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_MEDIA_BUCKET=videopilot-media
MEDIA_PROBE_ENABLED=true
FFPROBE_EXECUTABLE=ffprobe
MEDIA_PROBE_TIMEOUT=30s
MEDIA_PROBE_MAX_OUTPUT_BYTES=65536
MEDIA_PROBE_MAX_CONCURRENCY=1
MEDIA_PROBE_BATCH_SIZE=10
MEDIA_PROBE_STALE_AFTER=5m
MEDIA_PROBE_SWEEP_DELAY=2s
CONTEXT_DERIVATION_ENABLED=true
FFMPEG_EXECUTABLE=ffmpeg
FFMPEG_DERIVATION_TIMEOUT=2h
FFMPEG_MAX_LOG_BYTES=65536
FFMPEG_MAX_CONCURRENCY=1
AUDIO_SLICE_DURATION=60s
FRAME_FALLBACK_INTERVAL=30s
MAX_FRAMES_PER_MINUTE=6
FFMPEG_MAX_OUTPUT_FILES=20000
FFMPEG_MAX_OUTPUT_BYTES=21474836480
MEDIA_UPLOAD_PART_SIZE=8MB
MEDIA_UPLOAD_MAX_PARTS=10000
MEDIA_UPLOAD_SESSION_TTL=1h
MEDIA_UPLOAD_PART_URL_TTL=15m
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
DEPENDENCY_HEALTH_TIMEOUT=2s
MINIO_HEALTH_URL=http://localhost:9000/minio/health/ready
QDRANT_HEALTH_URL=http://localhost:6333/healthz
